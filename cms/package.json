{
  "name": "polaris-cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck:functions": "tsc --noEmit -p tsconfig.functions.json",
    "pages:dev": "npm run build && wrangler pages dev dist --d1=DB --r2=MEDIA",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "d1:migrate:local": "wrangler d1 migrations apply polaris-cms --local",
    "d1:migrate:remote": "wrangler d1 migrations apply polaris-cms --remote",
    "migrate:news": "tsx scripts/migrate-news.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "migrate:content-to-html": "tsx scripts/migrate-content-to-html.ts"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1",
    "unsane": "^0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "wrangler": "^4.20.0"
  }
}
