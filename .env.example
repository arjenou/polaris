# このファイルをコピーして .env.local を作成してください（.env.local は Git 管理外）。
# Vercel 側では同じキーを Project Settings > Environment Variables に登録します。

# 退去受付フォームの通知メール送信用 SMTP 設定。
# Google Workspace の場合は通常のログインパスワードではなく
# 「アプリパスワード」（16桁）を SMTP_PASS に設定します。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kanri@example.com
SMTP_PASS=

# 退去受付フォームの通知先。カンマ区切りで複数指定できる。
# 未設定の場合は SMTP_USER に送信される。
MOVE_OUT_MAIL_TO=kanri@example.com,admin@example.com

# 公開 CMS API（既定値あり）
# CMS_API_URL=https://polaris.api.yingmu-tech.com
# NEXT_PUBLIC_CMS_API_URL=https://polaris.api.yingmu-tech.com

# サイトの公開 URL（metadata / sitemap / robots 用）
# NEXT_PUBLIC_SITE_URL=https://example.com

# CMS からの on-demand ISR 再検証に使う共有シークレット
# REVALIDATE_SECRET=
