mg loading=\"lazy\" decoding=\"async\" width=\"3834\" height=\"1516\" src=\"https:\/\/mampuku-osaka.com\/wp-content\/uploads\/2025\/05\/\u77e9\u5f62-25-\u62f7\u8d1d-3@2x-1.png\" class=\"attachment-full size-full wp-image-1988\" alt=\"\" srcset=\"https:\/\/mampuku-osaka.com\/wp-content\/uploads\/2025\/05\/\u77e9\u5f62-25-\u62f7\u8d1d-3@2x-1.png 3834w, https:\/\/mampuku-osaka.com\/wp-content\/uploads\/2025\/05\/\u77e9\u5f62-25-\u62f7\u8d1d-3@2x-1-300x119.png 300w, https:\/\/mampuku-osaka.com\/wp-content\/uploads\/2025\/05\/\u77e9\u5f62-25-\u62f7\u8d1d-3@2x-1-1024x405.png 1024w, https:\/\/mampuku-osaka.com\/wp-content\/uploads\/2025\/05\/\u77e9\u5f62-25-\u62f7\u8d1d-3@2x-1-768x304.png 768w, https:\/\/mampuku-osaka.com\/wp-content\/uploads\/2025\/05\/\u77e9\u5f62-25-\u62f7\u8d1d-3@2x-1-1536x607.png 1536w, https:\/\/mampuku-osaka.com\/wp-content\/uploads\/2025\/05\/\u77e9\u5f62-25-\u62f7\u8d1d-3@2x-1-2048x810.png 2048w\" sizes=\"(max-width: 3834px) 100vw, 3834px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-49a20449 e-con-full e-flex e-con e-parent\" data-id=\"49a20449\" data-element_type=\"container\" data-settings=\"{&quot;jet_parallax_layout_list&quot;:[]}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-754bc6a4 elementor-widget elementor-widget-heading\" data-id=\"754bc6a4\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<p class=\"elementor-heading-title elementor-size-default\">\u65e5\u672c\u79fb\u4f4f\u30fb\u6295\u8d44\u652f\u63f4<\/p>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-32573c3 elementor-widget elementor-widget-html\" data-id=\"32573c3\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n    \n    .image-container {\n      position: relative;\n      width: 100%;\n      margin: 0 auto;\n      max-width: 1920px;\n      height: 610px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      \/* overflow: hidden; *\/\n    }\n    \n    .side-image {\n      width: 868px;\n      height: 520px;\n      position: absolute;\n      object-fit: cover;\n      transition: all 0.5s ease;\n      cursor: pointer; \/* \u6dfb\u52a0\u9f20\u6807\u6307\u9488\u6837\u5f0f *\/\n    }\n    \n    .left-image {\n      left: 0;\n      z-index: 1;\n    }\n    \n    .right-image {\n      right: 0;\n      z-index: 1;\n    }\n    \n    .center-image {\n      width: 1028px;\n      height: 610px;\n      z-index: 2;\n      position: absolute;\n      object-fit: cover;\n      transition: all 0.5s ease;\n    }\n    \n    .controls {\n      position: absolute;\n      bottom: -20px;\n      z-index: 3;\n      display: flex;\n      gap: 10px;\n      width: 1028px;\n      justify-content: center;\n    }\n    \n    .control-btn {\n      \/* width: 12px; *\/\n      flex: 1;\n      height: 6px;\n      \/* border-radius: 50%; *\/\n      background-color: #ccc;\n      cursor: pointer;\n      border: none;\n    }\n    \n    .control-btn.active {\n      background-color: rgba(0, 78, 162, 1);\n      cursor: default; \/* \u5f53\u524d\u9009\u4e2d\u7684\u6309\u94ae\u4e0d\u663e\u793a\u6307\u9488\u6837\u5f0f *\/\n    }\n    \n    .arrow {\n      position: absolute;\n      top: 50%;\n      transform: translateY(-50%);\n      z-index: 3;\n      background-color: rgba(255, 255, 255, 0.5);\n      border: none;\n      width: 40px;\n      height: 40px;\n      border-radius: 50%;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 20px;\n    }\n    \n    .prev {\n      left: 20px;\n    }\n    \n    .next {\n      right: 20px;\n    }\n  <\/style>\n<\/head>\n<body>\n  <div class=\"image-container\">\n    <!-- <button class=\"arrow prev\">\u2190<\/button>\n    <button class=\"arrow next\">\u2192<\/button> -->\n    <div class=\"controls\"><\/div>\n  <\/div>\n<\/body>\n<script>\n  \/\/ \u4e0d\u52a8\u4ea7\u4e70\u5356 && \u5ba4\u5185\u88c5\u6f62\n  const images1 =  [ \n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/\u77e9\u5f62-1983@2x-1.png\",\n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/\u8f6e\u64ad\u53f3868\uff0a520@2x.png\",\n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/PN-1-\u65e5.jpg\",\n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/PN-5-\u65e5.jpg\",\n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/06\/\u8f6e\u64ad\u5de6868\uff0a520@2x.png\",\n   ]\n\n \/\/ \u8d44\u4ea7\u7ba1\u7406\n  const images2 =  [ \n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/\u77e9\u5f62-\u8f6e\u64ad\u53f3868\uff0a520@2x.png\",\n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/\u8f6e\u64ad\u5de6868\uff0a520@2x-3.png\",\n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/\u77e9\u5f62-1983@2x-2.png\",\n   ]\n\n   \/\/ \u65e5\u672c\u8eab\u4efd\u89c4\u5212\n   const images3 =  [ \n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/\u77e9\u5f62-1983@2x-3.png\",\n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/\u8f6e\u64ad\u53f3868\uff0a520@2x-1.png\",\n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/\u6a31\u82b1\u5b63.jpg\",\n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/\u5948\u826f.jpg\",\n    \"https:\/\/polarisgroup-jp.www.aispacelab.cn\/wp-content\/uploads\/sites\/2\/2025\/05\/\u8f6e\u64ad\u5de6868\uff0a520@2x-2.png\",\n   ]\n\n  const images = [ \n    ...images3\n   ]\n\n   \/***\n    * \u4e09\u5f20\u56fe\u7247\uff0c\u5de6\u53f3\u4e24\u5f20\u56fe\u7247\u5bbd\u5ea6868\uff0c\u9ad8\u5ea6520\uff0c\u4e2d\u95f4\u56fe\u7247\u5bbd\u5ea61028\uff0c\u9ad8\u5ea6610\uff0c\u4e2d\u95f4\u7684\u5728\u6700\u4e0a\u9762\uff0c\u5de6\u53f3\u4e24\u5f20\u56fe\u7247\u5728\u4e2d\u95f4\u56fe\u7247\u7684\u4e24\u4fa7\n    * \n    *\/\n   const imageContainer = document.querySelector('.image-container');\n   const controlsContainer = document.querySelector('.controls');\n   const prevBtn = document.querySelector('.prev');\n   const nextBtn = document.querySelector('.next');\n   \n   let currentIndex = 0;\n   \n   \/\/ \u521b\u5efa\u8f6e\u64ad\u56fe\n   function createSlider() {\n     \/\/ \u521b\u5efa\u8db3\u591f\u7684\u56fe\u7247\u5143\u7d20\u4ee5\u5b9e\u73b0\u8f6e\u64ad\u6548\u679c\n     for (let i = 0; i < images.length; i++) {\n       \/\/ \u521b\u5efa\u4e2d\u95f4\u56fe\u7247\n       const centerImg = document.createElement('img');\n       centerImg.src = images[i];\n       centerImg.classList.add('center-image');\n       centerImg.style.display = i === currentIndex ? 'block' : 'none';\n       \/\/ \u4e2d\u95f4\u56fe\u7247\u4e0d\u6dfb\u52a0\u70b9\u51fb\u4e8b\u4ef6\uff0c\u56e0\u4e3a\u5b83\u662f\u5f53\u524d\u9009\u4e2d\u7684\n       imageContainer.appendChild(centerImg);\n       \n       \/\/ \u521b\u5efa\u5de6\u4fa7\u56fe\u7247\n       const leftImg = document.createElement('img');\n       leftImg.src = images[(i - 1 + images.length) % images.length];\n       leftImg.classList.add('side-image', 'left-image');\n       leftImg.style.display = i === currentIndex ? 'block' : 'none';\n       leftImg.addEventListener('click', () => prevSlide()); \/\/ \u6dfb\u52a0\u70b9\u51fb\u4e8b\u4ef6\n       imageContainer.appendChild(leftImg);\n       \n       \/\/ \u521b\u5efa\u53f3\u4fa7\u56fe\u7247\n       const rightImg = document.createElement('img');\n       rightImg.src = images[(i + 1) % images.length];\n       rightImg.classList.add('side-image', 'right-image');\n       rightImg.style.display = i === currentIndex ? 'block' : 'none';\n       rightImg.addEventListener('click', () => nextSlide()); \/\/ \u6dfb\u52a0\u70b9\u51fb\u4e8b\u4ef6\n       imageContainer.appendChild(rightImg);\n       \n       \/\/ \u521b\u5efa\u63a7\u5236\u70b9\n       const controlBtn = document.createElement('button');\n       controlBtn.classList.add('control-btn');\n       if (i === currentIndex) controlBtn.classList.add('active');\n       controlBtn.addEventListener('click', () => {\n         \/\/ \u53ea\u6709\u5f53\u524d\u672a\u9009\u4e2d\u7684\u6309\u94ae\u624d\u80fd\u70b9\u51fb\n         if (i !== currentIndex) {\n           goToSlide(i);\n         }\n       });\n       controlsContainer.appendChild(controlBtn);\n     }\n   }\n   \n   \/\/ \u5207\u6362\u5230\u6307\u5b9a\u5e7b\u706f\u7247\n   function goToSlide(index) {\n     \/\/ \u5982\u679c\u70b9\u51fb\u7684\u662f\u5f53\u524d\u5df2\u9009\u4e2d\u7684\uff0c\u5219\u4e0d\u6267\u884c\u4efb\u4f55\u64cd\u4f5c\n     if (index === currentIndex) {\n       return;\n     }\n     \n     \/\/ \u9690\u85cf\u6240\u6709\u56fe\u7247\n     const centerImages = document.querySelectorAll('.center-image');\n     const leftImages = document.querySelectorAll('.left-image');\n     const rightImages = document.querySelectorAll('.right-image');\n     const controlBtns = document.querySelectorAll('.control-btn');\n     \n     centerImages.forEach((img, i) => {\n       img.style.display = 'none';\n       controlBtns[i].classList.remove('active');\n     });\n     \n     leftImages.forEach(img => {\n       img.style.display = 'none';\n     });\n     \n     rightImages.forEach(img => {\n       img.style.display = 'none';\n     });\n     \n     \/\/ \u663e\u793a\u5f53\u524d\u7d22\u5f15\u7684\u56fe\u7247\n     centerImages[index].style.display = 'block';\n     leftImages[index].style.display = 'block';\n     rightImages[index].style.display = 'block';\n     controlBtns[index].classList.add('active');\n     \n     currentIndex = index;\n   }\n   \n   \/\/ \u4e0b\u4e00\u5f20\u5e7b\u706f\u7247\n   function nextSlide() {\n     goToSlide((currentIndex + 1) % images.length);\n   }\n   \n   \/\/ \u4e0a\u4e00\u5f20\u5e7b\u706f\u7247\n   function prevSlide() {\n     goToSlide((currentIndex - 1 + images.length) % images.length);\n   }\n   \n   \/\/ \u521d\u59cb\u5316\u8f6e\u64ad\u56fe\n   createSlider();\n   \n   \/\/ \u6dfb\u52a0\u4e8b\u4ef6\u76d1\u542c\u5668\n   if (prevBtn) prevBtn.addEventListener('click', prevSlide);\n   if (nextBtn) nextBtn.addEventListener('click', nextSlide);\n   \n   \/\/ \u81ea\u52a8\u8f6e\u64ad\n   let slideInterval = setInterval(nextSlide, 5000);\n   \n   \/\/ \u9f20\u6807\u60ac\u505c\u65f6\u6682\u505c\u81ea\u52a8\u8f6e\u64ad\n   imageContainer.addEventListener('mouseenter', () => {\n     clearInterval(slideInterval);\n   });\n   \n   \/\/ \u9f20\u6807\u79bb\u5f00\u65f6\u6062\u590d\u81ea\u52a8\u8f6e\u64ad\n   imageContainer.addEventListener('mouseleave', () => {\n     slideInterval = setInterval(nextSlide, 5000);\n   });\n<\/script>\n<\/html>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>\u5999\u89c1\u5ddd\u79be\uff08\u4e0a\u6d77\uff09\u5546\u52a1\u54a8\u8be2\u6709\u9650\u516c\u53f8 Services \u65e5\u672c\u79fb\u4f4f\u652f\u63f4 \u65e5\u672c\u6295\u8d44\u4f01\u753b \u6d77\u5916\u4e8b\u4e1a\u5f00\u53d1 \u77ed\u79df\u516c\u5bd3\u9879\u76ee\u706b\u70ed\u62db\u5546\u4e2d 2025.05.13 \u901a\u77e5 \u5343\u4ee3\u7530\u533a\u65b0\u529e\u516c\u5ba4\u6b63\u5f0f\u542f\u7528\u901a\u77e5 2025.05.09 \u91cd\u8981\u901a\u77e5 \u6211\u4eec\u5907\u53d7\u9009\u62e9 [&hellip;]<\/p>\n","protected":false},"author":1,"featured_media":0,"pa